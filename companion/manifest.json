{
  "manifest_version": 3,
  "name": "Campus AI Companion (validação local)",
  "version": "0.5.4",
  "description": "Rascunho local, não publicado. Mostra, num popup, os módulos da seção Atividades Avaliativas da AEDB depois do seu clique e pode abrir esse cartão. Nesta versão (pré-visualização) não salva nem envia nada.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Campus AI: pré-visualizar esta página",
    "default_popup": "src/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; form-action 'none'; base-uri 'none'"
  }
}
